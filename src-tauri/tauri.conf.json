{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SpecTape",
  "version": "0.1.0",
  "identifier": "com.zxtoolkit.spectape",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SpecTape",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "ZX Spectrum TZX/TAP tape editor",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["tzx"],
        "name": "TZX tape image",
        "description": "ZX Spectrum TZX tape image",
        "role": "Editor",
        "mimeType": "application/x-tzx"
      },
      {
        "ext": ["tap"],
        "name": "TAP tape image",
        "description": "ZX Spectrum TAP tape image",
        "role": "Editor",
        "mimeType": "application/x-tap"
      }
    ]
  }
}
