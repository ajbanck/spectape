{
  "name": "spectape",
  "version": "0.3.2",
  "private": true,
  "license": "GPL-2.0-or-later",
  "type": "module",
  "description": "ZX Spectrum TZX/TAP tape editor for the desktop and the browser",
  "scripts": {
    "dev": "vite",
    "predev": "node scripts/build-wasm.mjs",
    "build": "tsc --noEmit && vite build",
    "prebuild": "node scripts/build-wasm.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "pretest": "node scripts/build-wasm.mjs",
    "typecheck": "tsc --noEmit",
    "pretypecheck": "node scripts/build-wasm.mjs",
    "smoke": "node scripts/ui-smoke.mjs",
    "samples": "node scripts/make-samples.mjs",
    "core:wasm": "node scripts/build-wasm.mjs",
    "core:test": "cd core && cargo test",
    "desktop": "node scripts/build-native.mjs",
    "desktop:debug": "node scripts/build-native.mjs --debug",
    "desktop:test": "cd native && cargo test",
    "desktop:package": "node scripts/build-native.mjs --package",
    "core:fixtures": "node scripts/dump-blocks.mjs \"public/samples/SpecTape demo.tzx\" \"public/samples/SpecTape demo (variant).tzx\" \"public/samples/SpecTape demo.tap\""
  },
  "dependencies": {
    "@preact/signals": "^2.11.2",
    "pako": "^3.0.2",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.1",
    "@types/pako": "^2.0.4",
    "puppeteer-core": "^25.11.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
